{
  "info": {
    "name": "Tasks API",
    "description": "REST API for a simple task management system.\n\nNo authentication is required. Set the `baseUrl` collection variable to match your environment; it defaults to the address used by `php artisan serve`. `taskId` is captured automatically by the test script on \"Create task\", so the collection can be run from top to bottom.\n\nEvery request below carries a saved example response.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "List tasks",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "description": "Returns a paginated list of tasks, newest first."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responds 200', () => pm.response.to.have.status(200));",
              "pm.test('uses the success envelope', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.be.true;",
              "    pm.expect(body.data).to.be.an('array');",
              "    pm.expect(body.meta).to.have.property('total');",
              "});"
            ]
          }
        }
      ],
