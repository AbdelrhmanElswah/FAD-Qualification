              "pm.test('responds 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('returns the created task', () => {",
              "    pm.expect(body.success).to.be.true;",
              "    pm.expect(body.data).to.have.property('id');",
